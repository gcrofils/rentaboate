---
langs: [en, fr, ru]
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '/' if lang == 'en' else '/' + lang + '/' }}index.html"
---
{%- set s = settings -%}
{%- set home = { en: "/", fr: "/fr/", ru: "/ru/" } -%}
{%- set locale = { en: "en_GB", fr: "fr_FR", ru: "ru_RU" } -%}
{%- macro t(v) -%}{{ v[lang] }}{%- endmacro -%}
{%- macro photo(file, alt, cls, loading = "lazy") -%}
  {%- set d = file | dims -%}
  <img class="{{ cls }} object-cover" src="/assets/photos/{{ file }}" alt="{{ alt[lang] }}" width="{{ d.width }}" height="{{ d.height }}" loading="{{ loading }}">
{%- endmacro -%}
{%- set lisbon = { en: "Lisbon", fr: "Lisbonne", ru: "Лиссабон" } -%}
{%- set tagline = { en: "Our place. In the sun.", fr: "Chez nous. Au soleil.", ru: "У нас. На солнце." } -%}
{%- set pitch = { en: "Sunny central duplex with river view", fr: "Duplex lumineux, central, vue sur le Tage", ru: "Солнечный дуплекс в центре с видом на реку" } -%}
{%- set friends = { en: "Friends, and friends of friends.", fr: "Pour les amis, et les amis d'amis.", ru: "Для друзей и друзей друзей." } -%}
{%- set title = lisbon[lang] + ", " + s.season[lang] + ". " + tagline[lang] -%}
{%- set description = pitch[lang] + ". " + s.available[lang] + ". " + friends[lang] -%}
{%- set og_title = { en: title, fr: "On vous laisse les clés, du 21 déc. au 24 fév.", ru: title } -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <script async src="https://www.googletagmanager.com/gtm.js?id=G-SJ15CBTSQS"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    // Short visits don't show in Analytics; a first scroll sends one event so they do.
    addEventListener('scroll', () => gtag('event', 'scrolled'), { once: true, passive: true });
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {%- for l in langs %}
  <link rel="alternate" hreflang="{{ l }}" href="https://lisbon.milizone.com{{ home[l] }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="https://lisbon.milizone.com/">

  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#f4efe7">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Public+Sans:wght@400;600&family=Literata:ital,opsz,wght@0,7..72,400;1,7..72,400&family=Golos+Text:wght@400;600&display=swap">
  <link rel="stylesheet" href="/css/style.css">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ og_title[lang] }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://lisbon.milizone.com{{ home[lang] }}">
  <meta property="og:locale" content="{{ locale[lang] }}">
  {%- for l in langs %}{% if l != lang %}
  <meta property="og:locale:alternate" content="{{ locale[l] }}">
  {%- endif %}{% endfor %}
  <meta property="og:image" content="https://lisbon.milizone.com/assets/og-{{ lang }}.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ s.hero.alt[lang] }}">
  <meta name="twitter:card" content="summary_large_image">
</head>
<body class="bg-paper font-sans leading-relaxed text-ink">

<header class="relative h-[88svh] min-h-128 overflow-hidden after:absolute after:inset-0 after:bg-linear-to-b after:from-transparent after:from-30% after:to-ink/85">
  {{ photo(s.hero.file, s.hero.alt, "absolute inset-0 size-full", "eager") }}
  <div class="absolute inset-x-0 bottom-14 z-10 mx-auto max-w-5xl px-5 text-white">
    <div class="text-sm tracking-widest uppercase opacity-90">{{ t({ en: "Santos · Lisbon", fr: "Santos · Lisbonne", ru: "Сантуш · Лиссабон" }) }}</div>
    <h1 class="mt-2 mb-4 font-serif text-6xl leading-none md:text-7xl lg:text-8xl">{{ t({ en: "Lisbon,", fr: "Lisbonne,", ru: "Лиссабон," }) }} <em class="text-blush">{{ t(s.season) }}.</em></h1>
    <p class="max-w-md text-lg">{{ t({
      en: "Our place is free while we're away. Friends, and friends of friends.",
      fr: "Notre appart est libre pendant notre absence. Pour les amis, et les amis d'amis.",
      ru: "Наша квартира свободна, пока нас нет. Для друзей и друзей друзей."
    }) }}</p>
  </div>
</header>

<main class="mx-auto max-w-5xl px-5">
  <dl class="-mx-5 grid grid-cols-2 gap-px border-b border-rule bg-rule md:grid-cols-4">
    {%- for f in [
      { label: { en: "Available", fr: "Disponible", ru: "Свободно" }, value: s.available },
      { label: { en: "Sleeps", fr: "Couchage", ru: "Спальные места" }, value: s.sleeps },
      { label: { en: "Minimum stay", fr: "Séjour minimum", ru: "Минимальный срок" }, value: s.minimum_stay },
      { label: { en: "Rent", fr: "Loyer", ru: "Аренда" }, value: s.rent }
    ] %}
    <div class="bg-paper px-5 py-6">
      <dt class="text-xs tracking-widest text-muted uppercase">{{ t(f.label) }}</dt>
      <dd class="mt-1 font-serif text-xl leading-tight text-balance hyphens-auto md:text-2xl">{{ t(f.value) }}</dd>
    </div>
    {%- endfor %}
  </dl>

  <section class="grid items-start gap-5 py-12 md:grid-cols-5 md:gap-12 md:py-20">
    <h2 class="font-serif text-4xl leading-tight md:col-span-2">{{ t({
      en: "Sunny Central Duplex with River View",
      fr: "Duplex lumineux, central. Vue sur le Tage.",
      ru: "Солнечный дуплекс в центре с видом на реку"
    }) }}</h2>
    <p class="md:col-span-3">{{ t({
      en: "Sunny and airy apartment with Pombaline timber structural elements, a distinctive feature of Lisbon’s historic architecture.",
      fr: "Assez haut pour que la vue se mérite. Deux chambres, deux salles de bain, une vraie cuisine.",
      ru: "Солнечная, полная воздуха квартира с помбалинскими деревянными конструкциями — характерной чертой исторической архитектуры Лиссабона."
    }) }}</p>
  </section>

  <section class="columns-1 gap-4 sm:columns-2 lg:columns-3">
    {%- for p in s.photos %}{% if not p.paused %}
    <figure class="relative mb-4 break-inside-avoid">
      {{ photo(p.file, p.alt, "block w-full rounded") }}
      {%- if p.caption %}
      <figcaption class="absolute inset-x-0 bottom-0 rounded-b bg-linear-to-t from-ink/70 to-transparent px-3 pt-8 pb-2 text-sm text-white">{{ t(p.caption) }}</figcaption>
      {%- endif %}
    </figure>
    {%- endif %}{% endfor %}
  </section>

  <section class="grid items-start gap-8 pt-16 md:grid-cols-5 md:gap-12 md:pt-24">
    <div class="space-y-4 md:col-span-3 md:col-start-3">
      {%- if lang == "en" %}
      <div class="space-y-4">
        <p>Our place has 2 bedrooms and 2 bathrooms, one with a bathtub. On the first level, there is a fully equipped kitchen with a dishwasher and washing machine.</p>
        <p>There is a pleasant dining area with an extendable table for 6 guests, a living room, and a small nook by the window where you can enjoy your morning coffee while listening to your favourite music on the Sonos. This level also has one bedroom and a bathroom with a walk-in shower.</p>
        <p>Our place has many paintings and art pieces. Some of the kitchenware is vintage or artisanal, collected from around Europe.</p>
        <p>On the second level, there is a second bedroom and a bathroom. There is also a working desk with a view of the Tejo river, as well as a small extendable balcony where you can enjoy a glass of Vinho Verde with the view.</p>
        <p>All rooms have reversible air conditioning, so it heats too. We rarely use it, but some winter evenings call for it.</p>
        <p>Our neighbourhood is situated between Santos and Lapa, surrounded by various cafés and restaurants. At the same time, we are on a quiet one-way street. Santos train station is only a few minutes’ walk away, from where you can travel to the beaches towards Cascais. Cais do Sodré is about a 10-minute walk away, making it easy to catch a bus towards Avenida or walk uphill to enjoy the greenery of Estrela Park.</p>
        <p>There are mini-markets and supermarkets all within a short walking distance.</p>
      </div>
      {%- elif lang == "fr" %}
      <div class="space-y-4">
        <p>Au premier niveau, la salle à manger peut accueillir 6 convives. Le salon comprend un petit coin près de la fenêtre, idéal pour du petit-déjeuner à l’apéritif. La cuisine inclut un lave-vaisselle et un lave-linge. La chambre principale a été refaite en novembre 2026. À ce niveau, il y a également les toilettes et la douche.</p>
        <p>Au deuxième niveau se trouvent une seconde chambre avec 2 lits simples et une salle de bain. Si vous tenez vraiment à travailler, le bureau offre une vue sur le Tage et un écran de 34". Le velux s’ouvre en un petit balcon, endroit parfait pour un verre de vinho verde en admirant le panorama.</p>
        <p>Toutes les pièces sont équipées d’une climatisation réversible. Nous l’utilisons rarement, mais certains soirs d’hiver peuvent en bénéficier.</p>
      </div>
      {%- else %}
      <div class="space-y-4">
        <p>В квартире 2 спальни и 2 ванные комнаты, в одной из них есть ванна. На первом уровне — полностью оборудованная кухня с посудомоечной и стиральной машинами.</p>
        <p>Здесь же уютная обеденная зона с раздвижным столом на 6 человек, гостиная и небольшой уголок у окна, где можно выпить утренний кофе под любимую музыку на Sonos. На этом уровне также одна спальня и ванная комната с душевой.</p>
        <p>В квартире много картин и предметов искусства. Часть посуды — винтажная или ручной работы, собранная по всей Европе.</p>
        <p>На втором уровне — вторая спальня и ванная комната. Там же рабочий стол с видом на реку Тежу и небольшой раскладной балкон, где можно выпить бокал винью верде, любуясь видом.</p>
        <p>Во всех комнатах есть кондиционеры, которые работают и на обогрев. Мы редко ими пользуемся, но в некоторые зимние вечера они пригодятся.</p>
        <p>Наш район находится между Сантушем и Лапой, вокруг много кафе и ресторанов. При этом мы живём на тихой улице с односторонним движением. До вокзала Сантуш всего несколько минут пешком — оттуда можно доехать до пляжей в сторону Кашкайша. До Кайш-ду-Содре около 10 минут пешком: оттуда легко сесть на автобус до Авениды или подняться в гору к зелени парка Эштрела.</p>
        <p>Минимаркеты и супермаркеты — в нескольких минутах ходьбы.</p>
      </div>
      {%- endif %}
    </div>
    <aside class="border-t border-rule pt-6 max-md:order-last md:col-span-2 md:col-start-1 md:row-start-1 md:border-t-0 md:pt-0">
      <h3 class="text-xs tracking-widest text-muted uppercase">{{ t({ en: "Good to know", fr: "Bon à savoir", ru: "Полезно знать" }) }}</h3>
      <ul class="mt-3 space-y-3">
        <li>{{ t({
          en: "There is no lift in our building, although the staircase is quite wide.",
          fr: "Il n’y a pas d’ascenseur dans notre immeuble. Mais à Lisbonne, ce ne sont pas les 4 étages qui vont vous impressionner.",
          ru: "В доме нет лифта, хотя лестница довольно широкая."
        }) }}</li>
        <li>{{ t({
          en: "There is no dedicated parking, but a car can be safely parked outside or in a paid car park about 10 minutes away.",
          fr: "Il n’y a pas de stationnement dédié, mais il est possible de garer une voiture en toute sécurité à l’extérieur ou dans un parking payant situé à environ 10 minutes.",
          ru: "Выделенной парковки нет, но машину можно спокойно оставить на улице или на платной парковке примерно в 10 минутах."
        }) }}</li>
      </ul>
    </aside>
  </section>

  <section class="pt-24 pb-20 text-center">
    <h2 class="font-serif text-4xl md:text-5xl">{{ t({ en: "Want it?", fr: "Ça vous tente ?", ru: "Заинтересовало?" }) }}</h2>
    <button id="open-contact" type="button" class="mt-6 cursor-pointer rounded-full bg-accent px-8 py-4 font-semibold text-white transition-colors hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{{ t({ en: "Message us", fr: "Écrivez-nous", ru: "Напишите нам" }) }}</button>
  </section>
</main>

<footer class="border-t border-rule px-5 pt-8 pb-10 text-center font-serif text-xl italic">{{ t({
  en: "A different winter? Lisbon.",
  fr: "Un hiver différent ? Lisbonne.",
  ru: "Другая зима? Лиссабон."
}) }}</footer>

<dialog id="contact" aria-labelledby="contact-title" class="m-auto w-11/12 max-w-sm rounded-lg bg-paper px-8 pt-10 pb-8 text-center text-ink backdrop:bg-ink/60">
  <button type="button" class="close absolute top-2 right-2 size-11 cursor-pointer text-lg text-muted" aria-label="{{ t({ en: 'Close', fr: 'Fermer', ru: 'Закрыть' }) }}">✕</button>
  <h2 id="contact-title" class="mb-2 font-serif text-3xl leading-tight">{{ t({
    en: "Message us.",
    fr: "Écrivez-nous.",
    ru: "Напишите нам."
  }) }}</h2>
  <p>{{ t({
    en: "You found this site, so you know how to reach us.",
    fr: "Vous avez trouvé ce site, vous saurez nous contacter.",
    ru: "Вы нашли этот сайт — значит, знаете, как с нами связаться."
  }) }}</p>
</dialog>

<nav class="fixed right-4 bottom-4 z-20 flex flex-col overflow-hidden rounded-full bg-white/85 shadow backdrop-blur" aria-label="Language">
  {%- for l in langs %}
  <a href="{{ home[l] }}" hreflang="{{ l }}" lang="{{ l }}"{% if l == lang %} aria-current="page"{% endif %} class="flex size-11 items-center justify-center text-xs font-semibold text-ink hover:bg-white aria-[current=page]:bg-ink aria-[current=page]:text-white focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent">{{ l | upper }}</a>
  {%- endfor %}
</nav>

<script>
  (() => {
    const dialog = document.getElementById('contact');
    document.getElementById('open-contact').addEventListener('click', () => dialog.showModal());
    dialog.querySelector('.close').addEventListener('click', () => dialog.close());
    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  })();
</script>
</body>
</html>
